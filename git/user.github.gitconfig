# Route GitHub credentials per repo by probing both gh-authenticated accounts
# and returning a token from whichever has push access to <owner>/<repo>. No
# global default, no per-repo config. See ../auto-identity.sh for the logic
# and ../README.md for the broader pitch.
#
# helper = "" clears the system-level GCM helper so it doesn't also prompt
# for github.com. Nothing else touches credential.https://github.com -- the
# gh auth setup-git blocks were removed from ~/.gitconfig.
[credential "https://github.com"]
	useHttpPath = true
	helper = ""
	helper = "!sh \"$HOME/.config/git/auto-identity.sh\" credential"

# Gist: strict ownership probe via `gh api gists/<id>`. useHttpPath = true
# is required so the gist id reaches the helper.
[credential "https://gist.github.com"]
	useHttpPath = true
	helper = ""
	helper = "!sh \"$HOME/.config/git/auto-identity.sh\" credential"

# Auto-set commit identity on clone / branch checkout to the noreply email of
# whichever gh account has push access to origin. With useConfigOnly = true
# in user.gitconfig, missing identity fails loudly via "tell me who you are"
# instead of committing with the wrong one. Requires git 2.54+.
[hook "auto-identity"]
	event = post-checkout
	command = "sh \"$HOME/.config/git/auto-identity.sh\" post-checkout"
