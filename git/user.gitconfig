[include]
        path = ./delta/delta.gitconfig
        path = ./git-worktrees/git-worktrees.gitconfig
        path = ./lazygit/lazygit.gitconfig

[diff]
        submodule = log

[alias]
        lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)%an <%ae>%Creset' --abbrev-commit
        root = rev-parse --show-toplevel
        nuke = "!f() { export GIT_ASK_YESNO=false; git clean -xdf ; git reset --hard; }; f"
[rerere]
        enabled = true
[pull]
        ff = only
[stash]
        showIncludeUntracked = true
[core]
        fsmonitor = true
        untrackedcache = true
        editor = "nvim -f"
        longpaths = true
[user]
        name = Matt Kotsenas
        useConfigOnly = true
[includeIf "hasconfig:remote.*.url:https://github.com/**"]
        path = ./user.github.gitconfig
[includeIf "hasconfig:remote.*.url:git@github.com:**"]
        path = ./user.github.gitconfig
[includeIf "hasconfig:remote.*.url:https://dev.azure.com/**"]
        path = ./user.azdo.gitconfig
[includeIf "hasconfig:remote.*.url:https://*@dev.azure.com/**"]
        path = ./user.azdo.gitconfig
[includeIf "hasconfig:remote.*.url:git@ssh.dev.azure.com:**"]
        path = ./user.azdo.gitconfig
[merge]
        tool = bc5
[diff]
        tool = bc5
[mergetool "bc5"]
        cmd = \"C:/Program Files/Beyond Compare 5/BCompare.exe\" -solo -ro -lefttitle=\"Local file\" -righttitle=\"Remote file\" -centertitle=\"Base file\" \"$LOCAL\" \"$REMOTE\" \"$BASE\" \"$MERGED\"
[mergetool]
        prompt = false
        keepBackup = false
