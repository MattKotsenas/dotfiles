{
  "mcpServers": {
    "aspire": {
      "tools": [
        "*"
      ],
      "type": "local",
      "command": "aspire",
      "args": [
        "mcp",
        "start"
      ],
      "source": "user"
    },
    "playwright": {
      "type": "local",
      "command": "npx",
      "tools": [
        "*"
      ],
      "args": [
        "@playwright/mcp@latest"
      ]
    }
  }
}