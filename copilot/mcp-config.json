{
  "mcpServers": {
    "aspire": {
      "tools": [
        "*"
      ],
      "type": "local",
      "command": "aspire",
      "args": [
        "mcp",
        "start"
      ],
      "source": "user"
    },
    "playwright": {
      "type": "local",
      "command": "npx",
      "tools": [
        "*"
      ],
      "args": [
        "@playwright/mcp"
      ]
    },
    "azure-devops": {
      "type": "http",
      "url": "https://mcp.dev.azure.com/",
      "tools": [
        "*"
      ]
    }
  }
}
