{
  "logLevel": "default",
  "banner": "never",
  "renderMarkdown": true,
  "experimental": true,
  "defaultPermissionMode": "allow-all",
  "model": "gpt-5.6-sol",
  "contextTier": "long_context",
  "effortLevel": "high",
  "tabs": {
    "enabled": false
  },
  "sidebar": {
    "enabled": false
  },
  "footer": {
    "showAiUsed": false,
    "showCustom": true
  },
  "statusLine": {
    "type": "command",
    "command": "pwsh -NoLogo -NoProfile -File \"%USERPROFILE%\\.copilot\\extensions\\turn-budget\\statusline.ps1\"",
    "padding": 0,
    "refreshInterval": 1
  },
  "includeCoAuthoredBy": false,
  "keepAlive": "busy"
}
