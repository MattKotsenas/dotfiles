{
    "editor.rulers": [
        120
    ],
    "security.promptForLocalFileProtocolHandling": false,
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "workbench.colorTheme": "Catppuccin Mocha",
    "workbench.iconTheme": "catppuccin-mocha",
    "catppuccin-icons.associations.files": {
        "owners.txt": "codeowners",

        "directory.build.props": "msbuild",
        "directory.build.targets": "msbuild",
        "directory.packages.props": "msbuild",
        "directory.build.rsp": "msbuild",
        "dirs.proj": "visual-studio"
    },
    "catppuccin-icons.associations.extensions": {
        "cs": "fsharp",
        "csx": "fsharp",

        "csproj.user": "vscode-ignore",

        ".xlf": "xml",

        "props": "msbuild",
        "targets": "msbuild",
        "proj": "visual-studio"
    },
    "catppuccin-icons.associations.folders": {
        ".pipelines": "folder_azure-pipelines",
        "eng": "folder_vscode",
        "targets": "folder_vscode",
        "artifacts": "folder_dist",
        "publish": "folder_dist",
        "obj": "folder_dist",
        "testresults": "folder_tests",
        ".vs": "folder_vscode"
    },
    "editor.multiCursorModifier": "ctrlCmd",
    "github.copilot.nextEditSuggestions.enabled": true,
    "chat.tools.terminal.autoApprove": {
        "dir": true,
        "dotnet build": true,
        "dotnet test": true,
        "dotnet clean": true,
        "dotnet restore": true
    },
    "diffEditor.renderSideBySide": false,
    "[yaml]": {
        "diffEditor.ignoreTrimWhitespace": false
    },
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
        "*.cs": "${capture}.designer.cs,${capture}.g.cs,${capture}.generated.cs,${capture}.run.json,${capture}.settings.json,${capture}.settings.*.json",
        "*.csproj": "${capture}.csproj.user",
        "*.json": "${capture}.Development.json",
        "*.cshtml": "${capture}.cshtml.cs,${capture}.cshtml.css",
        "*.razor": "${capture}.razor.cs,${capture}.razor.css",
        "*.resx": "${capture}.Designer.cs",
        "*.xaml": "${capture}.xaml.cs",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*"
    },
}