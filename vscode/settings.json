{
    "editor.rulers": [
        120
    ],
    "security.promptForLocalFileProtocolHandling": false,
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "workbench.colorTheme": "Catppuccin Mocha",
    "workbench.iconTheme": "catppuccin-mocha",
    "catppuccin-icons.associations.files": {
        "owners.txt": "codeowners",

        "directory.build.props": "msbuild",
        "directory.build.targets": "msbuild",
        "directory.packages.props": "msbuild",
        "directory.build.rsp": "msbuild",
        "dirs.proj": "visual-studio"
    },
    "catppuccin-icons.associations.extensions": {
        "cs": "fsharp",
        "csx": "fsharp",

        "csproj.user": "vscode-ignore",

        "props": "msbuild",
        "targets": "msbuild",
        "proj": "visual-studio"
    },
    "catppuccin-icons.associations.folders": {
        ".pipelines": "folder_azure-pipelines",
        "eng": "folder_vscode",
        "targets": "folder_vscode",
        "artifacts": "folder_dist",
        "publish": "folder_dist",
        "obj": "folder_dist",
        "testresults": "folder_tests",
        ".vs": "folder_vscode"
    },
    "editor.multiCursorModifier": "ctrlCmd"
}