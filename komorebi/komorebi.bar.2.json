{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.38/schema.bar.json",
  "monitor": {
    "index": 1,
    "work_area_offset": {
      "left": -5,
      "top": 40,
      "right": -5,
      "bottom": 40
    }
  },
  "font_family": "Segoe UI Semilight",
  "theme": {
    "palette": "Base16",
    "name": "CatppuccinMocha",
    "accent": "Base0E"
  },
  "transparency_alpha": 0,
  "grouping": {
    "kind": "Alignment",
    "style": "DefaultWithShadowB4O0S3",
    "rounding": 2
  },
  "mouse": {
    "on_secondary_click": {
      "message": {
        "type": "CloseWorkspace"
      }
    }
  },
  "left_widgets": [
    {
      "Komorebi": {
        "workspaces": {
          "enable": true,
          "hide_empty_workspaces": true
        },
        "layout": {
          "enable": true
        },
        "focused_container": {
          "enable": true,
          "show_icon": true,
          "display": "Icon"
        }
      }
    }
  ],
  "right_widgets": [
    
  ]
}
