{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.37/schema.bar.json",
  "monitor": {
    "index": 0,
    "work_area_offset": {
      "left": -5,
      "top": 40,
      "right": -5,
      "bottom": 40
    }
  },
  "font_family": "JetBrains Mono",
  "theme": {
    "palette": "Base16",
    "name": "Ashes",
    "accent": "Base0D"
  },
  "transparency_alpha": 0,
  "grouping": {
    "kind": "Alignment",
    "style": "DefaultWithShadowB4O0S3",
    "rounding": 2
  },
  "mouse": {
    "on_secondary_click": {
      "message": {
        "type": "CloseWorkspace"
      }
    }
  },
  "left_widgets": [
    {
      "Komorebi": {
        "workspaces": {
          "enable": true,
          "hide_empty_workspaces": false
        },
        "layout": {
          "enable": true
        },
        "focused_window": {
          "enable": true,
          "show_icon": true
        }
      }
    }
  ],
  "right_widgets": [
    {
      "Media": {
        "enable": true
      }
    },
    {
      "Cpu": {
        "enable": true
      }
    },
    {
      "Memory": {
        "enable": true
      }
    },
    {
      "Network": {
        "enable": true,
        "show_default_interface": false,
        "show_total_data_transmitted": false,
        "show_network_activity": true
      }
    },
    {
      "Time": {
        "enable": true,
        "changing_icon": true,
        "format": {
          "Custom": "%I:%M:%S %p %Z"
        },
          "timezone": "UTC"
      }
    },
    {
      "Time": {
        "enable": true,
        "changing_icon": true,
        "format": {
          "Custom": "%I:%M:%S %p IDC"
        },
          "timezone": "Asia/Kolkata"
      }
    },
    {
      "Time": {
        "enable": true,
        "changing_icon": true,
        "format": {
          "Custom": "%I:%M:%S %p ILDC"
        },
          "timezone": "Asia/Tel_Aviv"
      }
    },
    {
      "Time": {
        "enable": true,
        "changing_icon": true,
        "format": {
          "Custom": "%a %m/%d %I:%M:%S %p %Z"
        },
          "timezone": "America/Los_Angeles"
      }
    },
    {
      "Battery": {
        "enable": true
      }
    }
  ]
}
