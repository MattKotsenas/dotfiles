{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.json",
  "app_specific_configuration_path": "$Env:USERPROFILE/.config/komorebi/applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "animation": {
    "enabled": false,
    "style": "EaseOutSine"
  },
  "window_handling_behaviour": "Async",
  "default_workspace_padding": 5,
  "default_container_padding": 5,
  "transparency": false,
  "transparency_alpha": 215,
  "border": true,
  "border_width": 8,
  "border_offset": -1,
  "theme": {
    "palette": "Catppuccin",
    "name": "Mocha",
    "unfocused_border": "Surface1",
    "focused_border": "Mauve",
    "stack_border": "Mauve",
    "single_border": "Sapphire",
    "bar_accent": "Mauve"
  },
  "mouse_follows_focus": true,
  "stackbar": {
    "mode": "Never"
  },
  "manage_rules": [
    {
      "kind": "Title",
      "matching_strategy": "Equals",
      "id": "JetBrains dotPeek"
    }
  ],
  "monitors": [
    {
      "workspaces": [
        {
          "name": "main",
          "layout": "RightMainVerticalStack",
          "workspace_rules": []
        },
        {
          "name": "chat",
          "layout": "Columns",
          "window_container_behaviour": "Create",
          "workspace_rules": []
        }
      ]
    },
    {
      "workspaces": [
        {
          "name": "main",
          "layout": "BSP",
          "workspace_rules": []
        },
        {
          "name": "chat",
          "layout": "Columns",
          "window_container_behaviour": "Create",
          "workspace_rules": [
            {
              "id": "outlook.exe",
              "kind": "Exe",
              "matching_strategy": "Equals"
            },
            {
              "id": "olk.exe",
              "kind": "Exe",
              "matching_strategy": "Equals"
            },
            {
              "id": "slack.exe",
              "kind": "Exe",
              "matching_strategy": "Equals"
            },
            {
              "id": "Discord.exe",
              "kind": "Exe",
              "matching_strategy": "Equals"
            }
          ]
        }
      ]
    }
  ]
}
