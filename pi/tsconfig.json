{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "agent/extensions/delegation/*.ts",
    "agent/extensions/openai-quota-resume/*.ts",
    "agent/extensions/bookmarks/*.ts",
    "agent/extensions/tangent.ts",
    "agent/extensions/compact-footer.ts",
    "agent/extensions/cost/*.ts",
    "agent/extensions/shared/*.ts"
  ]
}
