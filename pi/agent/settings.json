{
  "defaultModel": "gpt-6.1-sol",
  "defaultProvider": "github-copilot",
  "defaultThinkingLevel": "medium",
  "defaultTools": ["+codemode"],
  "lastChangelogVersion": "0.99.1",
  "packages": [
    "npm:@firstpick/pi-extension-cd"
  ],
  "piRetry": {
    "baseDelayMs": 10000,
    "maxDelayMs": 3600000,
    "multiplier": 2,
    "maxRetriesAtMaxDelay": 8
  },
  "skills": [
    "~/.copilot/installed-plugins/grove",
    "~/.copilot/installed-plugins/agent-plugins/git-good/skills",
    "~/.copilot/installed-plugins/agent-plugins/prune/skills",
    "~/.copilot/installed-plugins/agent-plugins/tuicr/skills",
    "~/.copilot/installed-plugins/dotnet-skills/dotnet-skills/skills"
  ],
  "terminal": {
    "showTerminalProgress": true
  },
  "tuiMode": "fullscreen"
}