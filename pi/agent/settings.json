{
  "defaultModel": "gpt-6.1-sol",
  "defaultProvider": "github-copilot",
  "defaultThinkingLevel": "medium",
  "cacheWarming": "idle",
  "defaultTools": [
    "+codemode"
  ],
  "lastChangelogVersion": "1.2.0",
  "packages": [
    "./extensions/powerline-chrome.ts",
    "./extensions/vim-navigation.ts",
    "npm:pi-powerline-footer",
    "npm:pi-vim-editor@0.4.0",
    "git:github.com/otahontas/pi-coding-agent-catppuccin"
  ],
  "powerline": {
    "preset": "default",
    "customItems": [
      {
        "id": "vim-mode",
        "color": "accent"
      },
      {
        "id": "compact-model",
        "color": "#d787af"
      },
      {
        "id": "compact-context",
        "color": "dim"
      },
      {
        "id": "compact-context-warn",
        "color": "warning"
      },
      {
        "id": "compact-context-error",
        "color": "error"
      },
      {
        "id": "compact-cost",
        "color": "dim"
      }
    ],
    "disabledSegments": [
      "model",
      "thinking",
      "context_pct",
      "context_total",
      "cache_read",
      "cache_write",
      "cost"
    ],
    "layout": {
      "left": [
        "custom:vim-mode",
        "custom:compact-model",
        "shell_mode",
        "path",
        "git",
        "queue",
        "custom:compact-context",
        "custom:compact-context-warn",
        "custom:compact-context-error",
        "custom:compact-cost"
      ]
    },
    "path": {
      "mode": "abbreviated",
      "maxLength": 30
    },
    "welcome": false,
    "queue": {
      "compactPromptMode": "native"
    },
    "placement": "above"
  },
  "workingVibe": "technobabble",
  "workingVibeMode": "file",
  "additionalInstructions": {
    "paths": ["~/.copilot/instructions/*.instructions.md"]
  },
  "skills": [
    "~/.copilot/installed-plugins/grove",
    "~/.copilot/installed-plugins/agent-plugins/git-good/skills",
    "~/.copilot/installed-plugins/agent-plugins/prune/skills",
    "~/.copilot/installed-plugins/agent-plugins/tuicr/skills",
    "~/.copilot/installed-plugins/dotnet-skills/dotnet-skills/skills"
  ],
  "terminal": {
    "showTerminalProgress": true
  },
  "tuiMode": "fullscreen",
  "editorPaddingX": 2,
  "treeFilterMode": "default",
  "theme": "catppuccin-mocha",
  "hideThinkingBlock": true,
  "enabledModels": [
    "github-copilot/gpt-6-luna",
    "github-copilot/gpt-6.1-sol",
    "openai/gpt-6-luna",
    "openai/gpt-6.1-sol"
  ]
}