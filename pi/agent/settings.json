{
  "defaultModel": "gpt-6.1-sol",
  "defaultProvider": "github-copilot",
  "defaultThinkingLevel": "medium",
  "cacheWarming": "idle",
  "defaultTools": ["+codemode"],
  "lastChangelogVersion": "0.99.1",
  "packages": [
    "npm:pi-powerline-footer",
    "git:github.com/otahontas/pi-coding-agent-catppuccin"
  ],
  "powerline": {
    "preset": "default",
    "model": {
      "display": "qualified",
      "showThinkingLevel": true
    },
    "disabledSegments": [
      "thinking"
    ],
    "layout": {
      "left": [
        "model",
        "shell_mode",
        "path",
        "git",
        "queue",
        "context_pct",
        "context_total",
        "cache_read",
        "cost"
      ]
    },
    "path": {
      "mode": "abbreviated",
      "maxLength": 30
    },
    "context": {
      "format": "percent"
    },
    "cache_read": {
      "format": "percent"
    },
    "welcome": false,
    "queue": {
      "compactPromptMode": "native"
    },
    "cost": {
      "subscriptionDisplay": "reported-cost",
      "currency": "USD"
    }
  },
  "workingVibe": "off",
  "piRetry": {
    "baseDelayMs": 10000,
    "maxDelayMs": 3600000,
    "multiplier": 2,
    "maxRetriesAtMaxDelay": 8
  },
  "skills": [
    "~/.copilot/installed-plugins/grove",
    "~/.copilot/installed-plugins/agent-plugins/git-good/skills",
    "~/.copilot/installed-plugins/agent-plugins/prune/skills",
    "~/.copilot/installed-plugins/agent-plugins/tuicr/skills",
    "~/.copilot/installed-plugins/dotnet-skills/dotnet-skills/skills"
  ],
  "terminal": {
    "showTerminalProgress": true
  },
  "tuiMode": "fullscreen",
  "theme": "catppuccin-mocha"
}