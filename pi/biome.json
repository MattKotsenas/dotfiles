{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "agent/extensions/bookmarks/*.ts",
      "tests/bookmarks.test.mjs",
      "tests/bookmarks.pty.mjs",
      "agent/extensions/delegation/*.ts",
      "agent/extensions/openai-quota-resume/*.ts",
      "tests/quota-resume.acceptance.test.mjs",
      "tests/quota-resume.pty.mjs",
      "tests/quota-resume/**/*.mjs",
      "tests/delegation.*.test.mjs",
      "tests/delegation/**/*.mjs",
      "package.json",
      "tsconfig.json",
      "biome.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "linter": { "rules": { "preset": "recommended" } }
}
