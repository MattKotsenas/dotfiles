;; Simple mods
;; Features:
;;   - Tap caps for esc
;;   - Hold right alt to remap right arrow to right control

(defcfg
  process-unmapped-keys yes
)
(defsrc
  caps ralt right
)
(defvar
  ;; Note: consider using different time values for your different fingers.
  ;; For example, your pinkies might be slower to release keys and index
  ;; fingers faster.
  tap-time 200
  hold-time 150
)
(deflayermap (base)
  caps esc
  ralt (multi ralt (layer-while-held komorebi))
)
(deflayermap (komorebi)
  right rctrl
)