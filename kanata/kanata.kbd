;; wm-workspace: one-shot sub-mode (each action returns to typing; peer sub-modes switchable)
(deflayermap (wm-workspace)
  w (layer-switch wm-workspace)
  f (layer-switch wm-focus)
  d (layer-switch wm-move)
  s (layer-switch wm-stack)
  e (layer-switch wm-resize)
  a (layer-switch wm-admin)
  spc (layer-switch pointer)
  1 (multi (push-msg "wm.workspace.focus.0") (layer-switch base-default))
  2 (multi (push-msg "wm.workspace.focus.1") (layer-switch base-default))
  3 (multi (push-msg "wm.workspace.focus.2") (layer-switch base-default))
