;; AUTO-GENERATED by keymap-gen. Do not edit by hand.
;; Edit keyboard/keymap-gen/Keymap.cs and run keyboard/regen.ps1

(defcfg
  process-unmapped-keys yes
)

(defsrc
  caps r p tab / q g
)

(defvar
  os-timeout 2000
  td-timeout 250
)

;; base: typing layer. CAP tap-dances into WM mode.
(deflayermap (base)
  caps (tap-dance $td-timeout (
    (one-shot $os-timeout (layer-while-held wm))
    (layer-switch wm-toggle)
  ))
)

;; wm: one-shot WM mode (CAP single-tap)
(deflayermap (wm)
  w (one-shot $os-timeout (layer-while-held wm-workspace))
  f (one-shot $os-timeout (layer-while-held wm-focus))
  d (one-shot $os-timeout (layer-while-held wm-move))
  s (one-shot $os-timeout (layer-while-held wm-stack))
  e (one-shot $os-timeout (layer-while-held wm-resize))
  a (one-shot $os-timeout (layer-while-held wm-assemble))
  r (push-msg "wm.layout.retile")
  p (push-msg "wm.layout.toggle-pause")
  tab (push-msg "wm.focus.last-workspace")
  / (push-msg "system.cheatsheet")
  q (push-msg "wm.move.promote")
  g (push-msg "wm.focus.cycle-next")
  ___ XX
)

;; wm-toggle: sticky WM mode (CAP double-tap)
(deflayermap (wm-toggle)
  caps (layer-switch base)
  w (layer-switch wm-workspace-toggle)
  f (layer-switch wm-focus-toggle)
  d (layer-switch wm-move-toggle)
  s (layer-switch wm-stack-toggle)
  e (layer-switch wm-resize-toggle)
  a (layer-switch wm-assemble-toggle)
  r (push-msg "wm.layout.retile")
  p (push-msg "wm.layout.toggle-pause")
  tab (push-msg "wm.focus.last-workspace")
  / (push-msg "system.cheatsheet")
  q (push-msg "wm.move.promote")
  g (push-msg "wm.focus.cycle-next")
  ___ XX
)

;; wm-workspace: one-shot sub-mode (auto-exits after one action)
(deflayermap (wm-workspace)
  1 (push-msg "wm.workspace.focus.0")
  2 (push-msg "wm.workspace.focus.1")
  3 (push-msg "wm.workspace.focus.2")
  4 (push-msg "wm.workspace.focus.3")
  5 (push-msg "wm.workspace.focus.4")
  6 (push-msg "wm.workspace.focus.5")
  7 (push-msg "wm.workspace.focus.6")
  8 (push-msg "wm.workspace.focus.7")
  ___ XX
)

;; wm-focus: one-shot sub-mode (auto-exits after one action)
(deflayermap (wm-focus)
  h (push-msg "wm.focus.left")
  j (push-msg "wm.focus.down")
  k (push-msg "wm.focus.up")
  l (push-msg "wm.focus.right")
  t (push-msg "wm.layout.toggle-float")
  m (push-msg "wm.layout.toggle-monocle")
  x (push-msg "wm.layout.flip-horizontal")
  y (push-msg "wm.layout.flip-vertical")
  ___ XX
)

;; wm-move: one-shot sub-mode (auto-exits after one action)
(deflayermap (wm-move)
  h (push-msg "wm.move.left")
  j (push-msg "wm.move.down")
  k (push-msg "wm.move.up")
  l (push-msg "wm.move.right")
  1 (push-msg "wm.workspace.move-to.0")
