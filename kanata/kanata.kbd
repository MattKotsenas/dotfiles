;; Simple mods
;; Features:
;;   - Tap caps for esc
;;   - Long press caps for caps
;;   - Hold right alt to remap right arrow to right control

(defcfg
  process-unmapped-keys yes
)
(defsrc
  caps ralt right
)
(defvar
  tap-time 150
  long-press-time 400
)
(deflayermap (base)
  caps (tap-hold $tap-time $long-press-time esc caps)
  ralt (multi ralt (layer-while-held komorebi))
)
(deflayermap (komorebi)
  right rctrl
)