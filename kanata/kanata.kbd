  esc (layer-switch base-default)
  ___ XX
)

;; wm-move-toggle: sticky sub-mode (CAPS/ESC exit, peer sub-modes switchable)
(deflayermap (wm-move-toggle)
  caps (layer-switch base-default)
  w (layer-switch wm-workspace-toggle)
  f (layer-switch wm-focus-toggle)
  d (layer-switch wm-move-toggle)
  s (layer-switch wm-stack-toggle)
  e (layer-switch wm-resize-toggle)
  a (layer-switch wm-admin-toggle)
  h (push-msg "wm.move.left")
  j (push-msg "wm.move.down")
  k (push-msg "wm.move.up")
  l (push-msg "wm.move.right")
  q (push-msg "wm.move.promote")
  t (push-msg "wm.layout.toggle-float")
  m (push-msg "wm.layout.toggle-monocle")
  1 (push-msg "wm.workspace.move-to.0")
  2 (push-msg "wm.workspace.move-to.1")
  3 (push-msg "wm.workspace.move-to.2")
  4 (push-msg "wm.workspace.move-to.3")
  5 (push-msg "wm.workspace.move-to.4")
  6 (push-msg "wm.workspace.move-to.5")
  7 (push-msg "wm.workspace.move-to.6")
  8 (push-msg "wm.workspace.move-to.7")
  tab (push-msg "wm.focus.last-workspace")
  / (push-msg "system.cheatsheet")
  up up
  down down
  left left
  right right
  esc (layer-switch base-default)
  ___ XX
)

