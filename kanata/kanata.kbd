;; wm-resize: one-shot sub-mode (auto-exits after one action)
(deflayermap (wm-resize)
  h (push-msg "wm.resize.horizontal-decrease")
  j (push-msg "wm.resize.vertical-decrease")
  k (push-msg "wm.resize.vertical-increase")
  l (push-msg "wm.resize.horizontal-increase")
  ___ XX
)

;; wm-assemble: one-shot sub-mode (auto-exits after one action)
(deflayermap (wm-assemble)
  h (macro (push-msg "wm.stack.unstack") 100 (push-msg "wm.focus.cycle-next"))
  j (push-msg "wm.stack.cycle-prev")
  k (push-msg "wm.stack.cycle-next")
  l (macro (push-msg "wm.stack.unstack") 100 (push-msg "wm.focus.cycle-next"))
  ___ XX
)

