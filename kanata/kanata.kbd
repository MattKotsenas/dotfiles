;; AUTO-GENERATED by keymap-gen. Do not edit by hand.
;; Edit keyboard/keymap-gen/Keymap.cs and run keyboard/regen.ps1

(defcfg
  process-unmapped-keys yes
  movemouse-inherit-accel-state yes
  movemouse-smooth-diagonals yes
)

(defsrc
  caps esc lsft rsft lctl rctl lalt ralt lmet rmet tab / up down left right 1 2 3 4 5 6 7 8 h j k l g q t m n p u o r x y b c i v z 0 9 , . \ - [ ] ; grv = bspc w e a s d f ' ret spc home end pgup pgdn ins del f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12
)

(defvirtualkeys
  teams-join-focused (macro (unmod lctl j))
  teams-join-toast (macro (unmod lctl lsft j))
  pointer-indicator-on (macro f14)
  pointer-indicator-off (macro f15)
  pointer-hint-ui (macro f16)
  pointer-hint-grid (macro f17)
)

;; base-default: typing layer (default focus context). CAP enters one-shot WM mode.
(deflayermap (base-default)
  caps (layer-switch wm)
)

;; wm: one-shot WM mode (default context; first CAP). CAP again locks to sticky.
(deflayermap (wm)
  caps (layer-switch wm-toggle)
  spc (layer-switch pointer)
  w (layer-switch wm-workspace)
  f (layer-switch wm-focus)
  d (layer-switch wm-move)
  s (layer-switch wm-stack)
  e (layer-switch wm-resize)
  a (layer-switch wm-admin)
  tab (multi (push-msg "wm.focus.last-workspace") (layer-switch base-default))
  / (multi (push-msg "system.cheatsheet") (layer-switch base-default))
  up (multi up (layer-switch base-default))
  down (multi down (layer-switch base-default))
  left (multi left (layer-switch base-default))
  right (multi right (layer-switch base-default))
  esc (layer-switch base-default)
  lsft lsft
  rsft rsft
  lctl lctl
  rctl rctl
  lalt lalt
  ralt ralt
  lmet lmet
  rmet rmet
  ___ XX
)

