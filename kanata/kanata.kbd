;; Unified keyboard navigation system
;;
;; CapsLock enters WM mode (tap = toggle on/off, hold = while held).
;; HJKL for all directions. Left-hand home-row sub-modifiers select scope:
;;   F(ocus)  D(isplace/move)  S(tack)  E(xpand/resize)
;;
;; Bare HJKL in WM mode = passthrough (no action). Per-app inner navigation
;; will be added via komokana in a future phase.
;;
;; Border indicator is handled by layer-indicator.ps1, which connects to
;; kanata's TCP server and watches for LayerChange events.
;;
;; Requires the cmd_allowed kanata binary (kanata_winIOv2_cmd_allowed.exe).
;; See keyboard/README.md for full design rationale.

(defcfg
  process-unmapped-keys yes
  danger-enable-cmd yes
)

(defsrc
  caps
)

(defvar
  tap-time 200
  hold-time 300
)

;; ---------------------------------------------------------------------------
;; Base layer
;; ---------------------------------------------------------------------------
(deflayermap (base)
  caps (tap-hold $tap-time $hold-time
    ;; tap: switch to WM layer (indicator via TCP listener)
    (layer-switch wm)
    ;; hold: WM layer while held (indicator via TCP listener)
    (layer-while-held wm)
  )
)

;; ---------------------------------------------------------------------------
;; WM layer - komorebi operations
;; ---------------------------------------------------------------------------
(deflayermap (wm)
  ;; Toggle off: switch back to base
  caps (layer-switch base)

  ;; Sub-modifiers (left hand home row) ---
  s (layer-while-held wm-stack)
  d (layer-while-held wm-move)
  f (layer-while-held wm-focus)
  e (layer-while-held wm-resize)

  ;; Stack management ---
  [ (cmd komorebic cycle-stack previous)
  ] (cmd komorebic cycle-stack next)
  \ (cmd komorebic unstack)

  ;; Workspaces ---
  1 (cmd komorebic focus-workspaces 0)
  2 (cmd komorebic focus-workspaces 1)
  3 (cmd komorebic focus-workspaces 2)
  4 (cmd komorebic focus-workspaces 3)
  5 (cmd komorebic focus-workspaces 4)
  6 (cmd komorebic focus-workspaces 5)
  7 (cmd komorebic focus-workspaces 6)
  8 (cmd komorebic focus-workspaces 7)

  ;; Standalone actions ---
  t (cmd komorebic toggle-float)
  m (cmd komorebic toggle-monocle)
  r (cmd komorebic retile)
  q (cmd komorebic promote)
  x (cmd komorebic flip-layout horizontal)
  y (cmd komorebic flip-layout vertical)
  p (cmd komorebic toggle-pause)
  g (cmd komorebic cycle-focus next)

  ;; Last workspace (multi-monitor sync)
  ;; fork: if lalt held, pass through tab (for Alt+Tab); else sync workspaces
  tab (fork
    (cmd komorebic focus-last-workspace)
    tab
    (lalt))

  ;; Cheat sheet (/ key) - opens in WT quake window with glow
  / (cmd cmd.exe /c "%USERPROFILE%\\.config\\keyboard\\scripts\\cheatsheet.cmd")

  ;; Bare HJKL: intentionally unmapped = passthrough.
  ;; Phase 2 (komokana) will add per-app overrides here.
)

;; ---------------------------------------------------------------------------
;; Sub-layers (activated by holding S / D / F / E in WM layer)
;; ---------------------------------------------------------------------------

;; F + HJKL = komorebi focus
(deflayermap (wm-focus)
  h (cmd komorebic focus left)
  j (cmd komorebic focus down)
  k (cmd komorebic focus up)
  l (cmd komorebic focus right)
)

;; D + HJKL = komorebi move, D + 1-8 = move to workspace
(deflayermap (wm-move)
  h (cmd komorebic move left)
  j (cmd komorebic move down)
  k (cmd komorebic move up)
  l (cmd komorebic move right)
  1 (cmd komorebic move-to-workspace 0)
  2 (cmd komorebic move-to-workspace 1)
  3 (cmd komorebic move-to-workspace 2)
  4 (cmd komorebic move-to-workspace 3)
  5 (cmd komorebic move-to-workspace 4)
  6 (cmd komorebic move-to-workspace 5)
  7 (cmd komorebic move-to-workspace 6)
  8 (cmd komorebic move-to-workspace 7)
)

;; S + HJKL = komorebi stack
(deflayermap (wm-stack)
  h (cmd komorebic stack left)
  j (cmd komorebic stack down)
  k (cmd komorebic stack up)
  l (cmd komorebic stack right)
)

;; E + HJKL = komorebi resize
(deflayermap (wm-resize)
  h (cmd komorebic resize-axis horizontal decrease)
  j (cmd komorebic resize-axis vertical decrease)
  k (cmd komorebic resize-axis vertical increase)
  l (cmd komorebic resize-axis horizontal increase)
)