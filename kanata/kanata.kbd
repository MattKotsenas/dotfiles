;; Unified keyboard navigation system
;;
;; CapsLock is the WM prefix key (like tmux's Ctrl+Space):
;;   Single tap: one-shot prefix (next keys are a WM command, then back to base)
;;   Double tap: toggle WM mode (stay in for multi-step operations)
;;
;; In toggle mode, sub-modifiers are sticky: press D to enter move mode,
;; move as many windows as you want, press S to switch to stack mode, etc.
;; CapsLock exits toggle mode.
;;
;; HJKL for all directions. Left-hand home-row keys select scope:
;;   F(ocus)  D(isplace/move)  S(tack)  E(xpand/resize)  A(ssemble/stack-ops)
;;
;; Example one-shot: CapsLock, F, L = focus right (three taps, back to base)
;; Example toggle:   CapsLock×2, D, H, L, H = move left, right, left (sticky)
;;
;; Border indicator is handled by event-listeners (C# overlay window).
;; See keyboard/README.md for full design rationale.

(defcfg
  process-unmapped-keys yes
)

(defsrc
  caps
)

(defvar
  os-timeout 2000
  td-timeout 250
)

;; ---------------------------------------------------------------------------
;; Templates to reduce duplication between one-shot and toggle sub-layers
;; ---------------------------------------------------------------------------
(deftemplate wm-shared-actions (exit-action)
  ;; Workspaces
  1 (push-msg "komorebic focus-workspaces 0")
  2 (push-msg "komorebic focus-workspaces 1")
  3 (push-msg "komorebic focus-workspaces 2")
  4 (push-msg "komorebic focus-workspaces 3")
  5 (push-msg "komorebic focus-workspaces 4")
  6 (push-msg "komorebic focus-workspaces 5")
  7 (push-msg "komorebic focus-workspaces 6")
  8 (push-msg "komorebic focus-workspaces 7")

  ;; Stack management
  [ (push-msg "komorebic cycle-stack previous")
  ] (push-msg "komorebic cycle-stack next")
  \ (push-msg "komorebic unstack")

  ;; Standalone actions
  t (push-msg "komorebic toggle-float")
  m (push-msg "komorebic toggle-monocle")
  r (push-msg "komorebic retile")
  q (push-msg "komorebic promote")
  x (push-msg "komorebic flip-layout horizontal")
  y (push-msg "komorebic flip-layout vertical")
  p (push-msg "komorebic toggle-pause")
  g (push-msg "komorebic cycle-focus next")

  ;; Last workspace
  tab (fork
    (push-msg "komorebic focus-last-workspace")
    tab
    (lalt))

  ;; Cheat sheet
  / (push-msg "cheatsheet")

  ;; Deadkey everything else
  ___ XX
)

;; Template for toggle sub-layers (sticky, with sub-mod switching + shared actions)
;; Does NOT include 1-8 since move sub-layer overrides them for move-to-workspace
(deftemplate toggle-sublayer-nav (focus-layer move-layer stack-layer resize-layer assemble-layer)
  caps (layer-switch base)
  f (layer-switch $focus-layer)
  d (layer-switch $move-layer)
  s (layer-switch $stack-layer)
  e (layer-switch $resize-layer)
  a (layer-switch $assemble-layer)

  ;; Stack management
  [ (push-msg "komorebic cycle-stack previous")
  ] (push-msg "komorebic cycle-stack next")
  \ (push-msg "komorebic unstack")

  ;; Standalone actions
  t (push-msg "komorebic toggle-float")
  m (push-msg "komorebic toggle-monocle")
  r (push-msg "komorebic retile")
  q (push-msg "komorebic promote")
  x (push-msg "komorebic flip-layout horizontal")
  y (push-msg "komorebic flip-layout vertical")
  p (push-msg "komorebic toggle-pause")
  g (push-msg "komorebic cycle-focus next")
  tab (fork (push-msg "komorebic focus-last-workspace") tab (lalt))
  / (push-msg "cheatsheet")

  ___ XX
)

;; Workspace bindings for sub-layers that use focus-workspaces (not move-to)
(deftemplate ws-focus ()
  1 (push-msg "komorebic focus-workspaces 0")
  2 (push-msg "komorebic focus-workspaces 1")
  3 (push-msg "komorebic focus-workspaces 2")
  4 (push-msg "komorebic focus-workspaces 3")
  5 (push-msg "komorebic focus-workspaces 4")
  6 (push-msg "komorebic focus-workspaces 5")
  7 (push-msg "komorebic focus-workspaces 6")
  8 (push-msg "komorebic focus-workspaces 7")
)

;; ---------------------------------------------------------------------------
;; Base layer
;; ---------------------------------------------------------------------------
(deflayermap (base)
  caps (tap-dance $td-timeout (
    ;; single tap: one-shot prefix
    (one-shot $os-timeout (layer-while-held wm))
    ;; double tap: toggle WM mode
    (layer-switch wm-toggle)
  ))
)

;; ---------------------------------------------------------------------------
;; WM layer (one-shot mode) - entered via single CapsLock tap
;; Sub-modifiers use one-shot; the outer one-shot wrapper auto-exits after action
;; ---------------------------------------------------------------------------
(deflayermap (wm)
  f (one-shot $os-timeout (layer-while-held wm-focus))
  d (one-shot $os-timeout (layer-while-held wm-move))
  s (one-shot $os-timeout (layer-while-held wm-stack))
  e (one-shot $os-timeout (layer-while-held wm-resize))
  a (one-shot $os-timeout (layer-while-held wm-assemble))
  (template-expand wm-shared-actions _)
)

;; ---------------------------------------------------------------------------
;; WM toggle layer - entered via double CapsLock tap
;; Sub-modifiers switch to sticky toggle sub-layers
;; ---------------------------------------------------------------------------
(deflayermap (wm-toggle)
  caps (layer-switch base)
  f (layer-switch wm-focus-toggle)
  d (layer-switch wm-move-toggle)
  s (layer-switch wm-stack-toggle)
  e (layer-switch wm-resize-toggle)
  a (layer-switch wm-assemble-toggle)
  (template-expand wm-shared-actions _)
)

;; ---------------------------------------------------------------------------
;; One-shot sub-layers (one-shot wrapper handles exit to base)
;; ---------------------------------------------------------------------------
(deflayermap (wm-focus)
  h (push-msg "komorebic focus left")
  j (push-msg "komorebic focus down")
  k (push-msg "komorebic focus up")
  l (push-msg "komorebic focus right")
  ___ XX
)

(deflayermap (wm-move)
  h (push-msg "komorebic move left")
  j (push-msg "komorebic move down")
  k (push-msg "komorebic move up")
  l (push-msg "komorebic move right")
  1 (push-msg "komorebic move-to-workspace 0")
  2 (push-msg "komorebic move-to-workspace 1")
  3 (push-msg "komorebic move-to-workspace 2")
  4 (push-msg "komorebic move-to-workspace 3")
  5 (push-msg "komorebic move-to-workspace 4")
  6 (push-msg "komorebic move-to-workspace 5")
  7 (push-msg "komorebic move-to-workspace 6")
  8 (push-msg "komorebic move-to-workspace 7")
  ___ XX
)

(deflayermap (wm-stack)
  h (push-msg "komorebic stack left")
  j (push-msg "komorebic stack down")
  k (push-msg "komorebic stack up")
  l (push-msg "komorebic stack right")
  ___ XX
)

(deflayermap (wm-resize)
  h (push-msg "komorebic resize-axis horizontal decrease")
  j (push-msg "komorebic resize-axis vertical decrease")
  k (push-msg "komorebic resize-axis vertical increase")
  l (push-msg "komorebic resize-axis horizontal increase")
  ___ XX
)

;; ---------------------------------------------------------------------------
;; Toggle sub-layers (sticky, with sub-mod switching between them)
;; ---------------------------------------------------------------------------
(deflayermap (wm-focus-toggle)
  (template-expand toggle-sublayer-nav wm-focus-toggle wm-move-toggle wm-stack-toggle wm-resize-toggle wm-assemble-toggle)
  (template-expand ws-focus)
  h (push-msg "komorebic focus left")
  j (push-msg "komorebic focus down")
  k (push-msg "komorebic focus up")
  l (push-msg "komorebic focus right")
)

(deflayermap (wm-move-toggle)
  (template-expand toggle-sublayer-nav wm-focus-toggle wm-move-toggle wm-stack-toggle wm-resize-toggle wm-assemble-toggle)
  h (push-msg "komorebic move left")
  j (push-msg "komorebic move down")
  k (push-msg "komorebic move up")
  l (push-msg "komorebic move right")
  1 (push-msg "komorebic move-to-workspace 0")
  2 (push-msg "komorebic move-to-workspace 1")
  3 (push-msg "komorebic move-to-workspace 2")
  4 (push-msg "komorebic move-to-workspace 3")
  5 (push-msg "komorebic move-to-workspace 4")
  6 (push-msg "komorebic move-to-workspace 5")
  7 (push-msg "komorebic move-to-workspace 6")
  8 (push-msg "komorebic move-to-workspace 7")
)

(deflayermap (wm-stack-toggle)
  (template-expand toggle-sublayer-nav wm-focus-toggle wm-move-toggle wm-stack-toggle wm-resize-toggle wm-assemble-toggle)
  (template-expand ws-focus)
  h (push-msg "komorebic stack left")
  j (push-msg "komorebic stack down")
  k (push-msg "komorebic stack up")
  l (push-msg "komorebic stack right")
)

(deflayermap (wm-resize-toggle)
  (template-expand toggle-sublayer-nav wm-focus-toggle wm-move-toggle wm-stack-toggle wm-resize-toggle wm-assemble-toggle)
  (template-expand ws-focus)
  h (push-msg "komorebic resize-axis horizontal decrease")
  j (push-msg "komorebic resize-axis vertical decrease")
  k (push-msg "komorebic resize-axis vertical increase")
  l (push-msg "komorebic resize-axis horizontal increase")
)

;; A(ssemble) - stack cycling and unstack
;; h/l = unstack + refocus, j/k = cycle stack prev/next
(deflayermap (wm-assemble)
  h (macro (push-msg "komorebic unstack") 100 (push-msg "komorebic cycle-focus next"))
  j (push-msg "komorebic cycle-stack previous")
  k (push-msg "komorebic cycle-stack next")
  l (macro (push-msg "komorebic unstack") 100 (push-msg "komorebic cycle-focus next"))
  ___ XX
)

(deflayermap (wm-assemble-toggle)
  (template-expand toggle-sublayer-nav wm-focus-toggle wm-move-toggle wm-stack-toggle wm-resize-toggle wm-assemble-toggle)
  (template-expand ws-focus)
  h (macro (push-msg "komorebic unstack") 100 (push-msg "komorebic cycle-focus next"))
  j (push-msg "komorebic cycle-stack previous")
  k (push-msg "komorebic cycle-stack next")
  l (macro (push-msg "komorebic unstack") 100 (push-msg "komorebic cycle-focus next"))
)