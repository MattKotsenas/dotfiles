;; wm-stack: one-shot sub-mode (each action returns to typing; peer sub-modes switchable)
(deflayermap (wm-stack)
  w (layer-switch wm-workspace)
  f (layer-switch wm-focus)
  d (layer-switch wm-move)
  s (layer-switch wm-stack)
  e (layer-switch wm-resize)
  a (layer-switch wm-admin)
  spc (layer-switch pointer)
  h (multi (push-msg "wm.stack.left") (layer-switch base-default))
  j (multi (push-msg "wm.stack.down") (layer-switch base-default))
  k (multi (push-msg "wm.stack.up") (layer-switch base-default))
  l (multi (push-msg "wm.stack.right") (layer-switch base-default))
  n (multi (push-msg "wm.stack.cycle-next") (layer-switch base-default))
  p (multi (push-msg "wm.stack.cycle-prev") (layer-switch base-default))
  u (multi (push-msg "wm.stack.unstack") (layer-switch base-default))
  esc (layer-switch base-default)
  lsft lsft
  rsft rsft
  lctl lctl
  rctl rctl
  lalt lalt
  ralt ralt
  lmet lmet
  rmet rmet
  ___ XX
)

