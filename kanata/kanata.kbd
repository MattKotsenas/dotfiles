  8 (multi (push-msg "wm.workspace.focus.7") (layer-switch base-default))
  esc (layer-switch base-default)
  lsft lsft
  rsft rsft
  lctl lctl
  rctl rctl
  lalt lalt
  ralt ralt
  lmet lmet
  rmet rmet
