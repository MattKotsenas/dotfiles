;; AUTO-GENERATED by keymap-gen. Do not edit by hand.
;; Edit keyboard/keymap-gen/Keymap.cs and run keyboard/regen.ps1

(defcfg
  process-unmapped-keys yes
)

(defsrc
  caps lsft rsft esc tab / up down left right 1 2 3 4 5 6 7 8 h j k l g q t m n p u r x y b c i o v z 0 9 , . \ - [ ] ;
)

(defvar
  os-timeout 65535
  td-timeout 250
)

;; base-default: typing layer (default focus context). CAP tap-dances into WM mode.
(deflayermap (base-default)
  caps (tap-dance $td-timeout (
    (one-shot-release $os-timeout (layer-while-held wm))
    (layer-switch wm-toggle)
  ))
)

;; wm: one-shot WM mode (default context; CAP single-tap)
(deflayermap (wm)
  w (one-shot $os-timeout (layer-while-held wm-workspace))
  f (one-shot $os-timeout (layer-while-held wm-focus))
  d (one-shot $os-timeout (layer-while-held wm-move))
  s (one-shot $os-timeout (layer-while-held wm-stack))
  e (one-shot $os-timeout (layer-while-held wm-resize))
  a (one-shot $os-timeout (layer-while-held wm-admin))
  tab (push-msg "wm.focus.last-workspace")
  / (push-msg "system.cheatsheet")
  up up
  down down
  left left
  right right
  esc (layer-switch base-default)
  lsft lsft
  rsft rsft
  ___ XX
)

;; wm-toggle: sticky WM mode (default context; CAP double-tap)
;; CAPS or ESC exits to base-default.
(deflayermap (wm-toggle)
  caps (layer-switch base-default)
  w (layer-switch wm-workspace-toggle)
  f (layer-switch wm-focus-toggle)
  d (layer-switch wm-move-toggle)
  s (layer-switch wm-stack-toggle)
  e (layer-switch wm-resize-toggle)
  a (layer-switch wm-admin-toggle)
  tab (push-msg "wm.focus.last-workspace")
  / (push-msg "system.cheatsheet")
  up up
  down down
  left left
  right right
  esc (layer-switch base-default)
  lsft lsft
  rsft rsft
  ___ XX
)

