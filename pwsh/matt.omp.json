{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "console_title_template": "./{{ .Folder }}",
  "pwd": "osc99",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none",
            "folder_separator_icon": " \ue0b1 ",
            "home_icon": "~",
            "mapped_locations": {
              "C:/Projects/": "\ue65d",
              "D:/Projects/": "\ue65d"
            },
            "style": "agnoster_full"
          },
          "template": "<background,transparent>\ue0b6</> {{ .Path }} <background>\ue0b0</>",
          "foreground": "p:text",
          "background": "p:path",
          "type": "path",
          "style": "plain"
        },
        {
          "properties": {
            "branch_max_length": 0,
            "branch_icon": " ",
            "cache_duration": "none",
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "mapped_branches": {
              "bugfix/*": "🐛/",
              "feature/*": "\ud83d\ude80/",
              "refactor/*": " \uf1b8 /",
              "users/mattkot/*": "🧔/"
            },
            "source": "pwsh"
          },
          "template": "<parentBackground>\ue0b0</> {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} <background>\ue0b0</>",
          "foreground": "p:text",
          "background": "p:git-branch",
          "type": "git",
          "style": "plain",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:git-changed{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:git-ahead-behind{{ end }}",
            "{{ if gt .Ahead 0 }}p:git-ahead{{ end }}",
            "{{ if gt .Behind 0 }}p:git-behind{{ end }}"
          ]
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "<parentBackground>\ue0b0</>{{ if .Unsupported }}\uf071{{ else }} \ue77f {{ .Full }} {{ end }}<background>\ue0b0</>",
          "foreground": "p:text",
          "background": "p:dotnet",
          "type": "dotnet",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "fetch_version": true
          },
          "template": "<parentBackground>\ue0b0</> \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} <background>\ue0b0</>",
          "foreground": "p:text",
          "background": "p:node",
          "type": "node",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "fetch_version": true
          },
          "template": "<parentBackground>\ue0b0</> \ue626 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} <background>\ue0b0</>",
          "foreground": "p:text",
          "background": "p:go",
          "type": "go",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "display_mode": "files",
            "fetch_virtual_env": false
          },
          "template": "<parentBackground>\ue0b0</> \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} <background>\ue0b0</>",
          "foreground": "p:text",
          "background": "p:python",
          "type": "python",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "display_mode": "files",
            "fetch_version": true
          },
          "template": "<parentBackground>\ue0b0</> \ue791 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} <background>\ue0b0</>",
          "foreground": "p:text",
          "background": "p:ruby",
          "type": "ruby",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "display_mode": "files",
            "fetch_version": false
          },
          "template": "<parentBackground>\ue0b0</> \uf0e7{{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} <background?>\ue0b0</>",
          "foreground": "p:text",
          "background": "p:azfunc",
          "type": "azfunc",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "<parentBackground>\ue0b0</> \uf0ad <background>\ue0b0</>",
          "foreground": "p:text",
          "background": "p:root",
          "type": "root",
          "style": "plain"
        },
        {
          "properties": {
            "always_enabled": true,
            "cache_duration": "none"
          },
          "template": "<parentBackground>\ue0b0</> \uf520 {{ .FormattedMs }}<background>\ue0b0</>",
          "foreground": "p:text",
          "background": "p:execution-time",
          "type": "executiontime",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "{{if or .Env.POSH_JOBS_RUNNING .Env.POSH_JOBS_FINISHED }}<parentBackground>\ue0b0</> \udb86\udd35 {{ default 0 .Env.POSH_JOBS_RUNNING }} \udb86\udd37 {{ default 0 .Env.POSH_JOBS_FINISHED }}<background>\ue0b0</>{{ end }}",
          "foreground": "p:text",
          "background": "p:jobs",
          "type": "text",
          "style": "plain"
        },
        {
          "properties": {
            "always_enabled": true,
            "cache_duration": "none"
          },
          "template": "<parentBackground>\ue0b0</> {{ if eq .Code 0 }}\uf00c{{ else }}\uf00d{{ end }} <background,transparent>\ue0b4</>",
          "foreground": "p:text",
          "background": "p:status-success",
          "type": "status",
          "style": "plain",
          "background_templates": [
            "{{ if gt .Code 0 }}p:status-fail{{ end }}"
          ]
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "<background,transparent>\ue0b6</> \uf489 <background>\ue0b2</>",
          "foreground": "p:text",
          "background": "p:prompt",
          "type": "shell",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "charged_icon": "\uead0 ",
            "charging_icon": "⚡ ",
            "discharging_icon": "\uf240 "
          },
          "template": "<background,parentBackground>\ue0b2</> {{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }}{{ .Error }}%<background>\ue0b2</>",
          "foreground": "p:text",
          "type": "battery",
          "style": "plain",
          "background_templates": [
            "{{if eq \"Charging\" .State.String}}p:battery-charging{{end}}",
            "{{if eq \"Discharging\" .State.String}}p:battery-discharging{{end}}",
            "{{if eq \"Full\" .State.String}}p:battery-full{{end}}"
          ]
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "<background,parentBackground>\ue0b2</> {{ .CurrentDate | date .Format }} <background,transparent>\ue0b4</>",
          "foreground": "p:text",
          "background": "p:time",
          "type": "time",
          "style": "plain"
        }
      ]
    }
  ],
  "palette": {
    "path": "#8caaee",
    "time": "#89dceb",
    "text": "#303446",
    "git-branch": "#cdd6f4",
    "git-changed": "#ef9f76",
    "git-ahead-behind": "#f38ba8",
    "git-ahead": "#cba6f7",
    "git-behind": "#cba6f7",
    "battery-charging": "#74c7ec",
    "battery-discharging": "#f38ba8",
    "battery-full": "#a6e3a1",
    "prompt": "#89b4fa",
    "status-success": "#a6e3a1",
    "status-fail": "#f38ba8",
    "jobs": "#f5e0dc",
    "execution-time": "#b4befe",
    "root": "#f9e2af",
    "azfunc": "#fab387",
    "ruby": "#eba0ac",
    "python": "#f5c2e7",
    "go": "#94e2d5",
    "node": "#6CA35E",
    "dotnet": "#74c7ec"
  },
  "version": 3,
  "final_space": true
}
